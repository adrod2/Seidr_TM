# Server-side only. Never put GitHub credentials in a VITE_ variable.
# Authenticate with "copilot login" before starting the Copilot service.
# Repository access also requires "gh auth login --hostname github.com --web".
SEIDR_COPILOT_PORT=3001

# Optional search integration. Analysis caching is local in IndexedDB.
VITE_TAVILY_API_KEY=
